# Anima simulation (server-side only — never expose to the browser)
ANIMA_BASE_URL=https://sim.animahacks.com
# Preferred for demos: set the team bearer key here so Connect can skip paste
ANIMA_API_KEY=
# Optional alternative: create/join a world by team name via POST /api/keys
ANIMA_TEAM_NAME=

# OpenAI (optional — deterministic grounded answers work without this)
# Used via Anima ADK OpenAI Responses API (gpt-4o-mini default). Prefer a cheap model for hackathon demos.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CareCircle server
PORT=8787
CARE_CIRCLE_DATA_DIR=./data
SESSION_SECRET=dev-change-me

# Web (Vite)
VITE_API_BASE=http://localhost:8787
