# Agent model. With OPENAI_API_KEY set, Kindred runs on the OpenAI Responses API.
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.6-sol
AGENT_REASONING=medium
# Alternative: ANTHROPIC_API_KEY (claude-opus-5). With neither key set, a scripted fallback runs.
ANTHROPIC_API_KEY=

# Live data: Anima NHS-SIM. Get a team key once with
#   curl -X POST https://sim.animahealth.com/api/keys -H 'Content-Type: application/json' -d '{"teamName":"<team>"}'
SIM_API_KEY=
SIM_BASE_URL=https://sim.animahealth.com
# Local alternative (writable copy with enriched demo data, see sim-app/):
#   SIM_BASE_URL=http://localhost:4192   SIM_API_KEY=local-demo
# Which sim patient Kindred looks after (default: Eleanor Chen)
SIM_PATIENT_ID=SIM-000006

# Shared consent backend (keep both values server-side).
COMPANION_BASE_URL=http://localhost:4192
COMPANION_PUBLIC_URL=http://localhost:4192

# Production agent runtime storage (same Neon production database as sim-app).
DATABASE_URL=
KINDRED_RUNTIME_NAMESPACE=kindred-v1
# Required when the companion backend has Vercel deployment protection.
COMPANION_BYPASS_SECRET=
